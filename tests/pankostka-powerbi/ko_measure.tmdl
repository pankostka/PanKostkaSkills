/// celkem 4
table FactProdej
	measure HV = SUM ( FactProdej[ProdejKc] )
		displayFolder: Výsledek

	measure Obrat = SUM ( FactProdej[ProdejKc] )
		formatString: #,0

	measure 'HV △LY' = [HV] - [HV LY]
		formatString: #,0
		displayFolder: Výsledek

	measure 'HV LY YTD' = CALCULATE ( [HV LY], DATESYTD ( DimDatum[Date] ) )
		formatString: #,0
		displayFolder: Výsledek
